# SmartRent B2B: variaveis de ambiente (RNF03). Este arquivo e so um MODELO: copie para .env (ignorado pelo git)
# ou cadastre os valores no painel do Render. NUNCA coloque valores reais aqui.
#
# Gerar segredos aleatorios:   openssl rand -base64 32

# --- Perfil ---
# dev: dispensa JWT_SECRET, SMARTCHAT_CRYPTO_KEY e SMARTCHAT_HMAC_KEY (usa chaves PUBLICAS de desenvolvimento) e aceita
# a chave de teste do reCAPTCHA. Nunca use em producao.
SPRING_PROFILES_ACTIVE=

# --- Banco (Supabase/PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Segredos (obrigatorios fora de dev/test; a aplicacao nao sobe sem eles) ---
JWT_SECRET=                 # pelo menos 32 bytes
SMARTCHAT_CRYPTO_KEY=       # Base64 de 32 bytes; perder o valor torna as mensagens irrecuperaveis (guarde backup separado)
SMARTCHAT_HMAC_KEY=         # Base64 de pelo menos 32 bytes

# --- reCAPTCHA v2 (obrigatorio fora de dev/test: com a chave de teste do Google a aplicacao nao sobe) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# --- Site e e-mail ---
APP_BASE_URL=https://seu-dominio.exemplo
FORWARD_HEADERS_STRATEGY=framework   # atras de proxy (Render): usa X-Forwarded-For para o IP
EMAIL_LOG_CORPO=false                # nunca registrar links com token em log
BREVO_API_KEY=
EMAIL_REMETENTE=

# --- Integracoes opcionais ---
GOOGLE_CLIENT_ID=
GROQ_API_KEY=

# --- Midias ---
# Cloudflare R2 (sem estas variaveis as fotos ficam no disco, apagado a cada deploy no Render)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_URL_PUBLICA=
MIDIA_MAX_PIXELS_IMAGEM=30000000
VIDEO_FFMPEG_PATH=                   # vazio = procura "ffmpeg" no PATH (sem ele, videos sao recusados fora de dev/test)

# --- Outros ---
SMARTRENT_CORS_ORIGENS=              # vazio = so mesma origem; senao, origens separadas por virgula
HTTP_JSON_MAX_BYTES=1048576
